generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Article {
  id              String   @id @default(cuid())
  title           String
  content         String
  status          String   @default("draft")
  createdAt       DateTime @default(now())
  author          String?
  featuredImg     String?
  sourceLink      String?
  tags            String[]
  category        String?
  socialPostUrls  String[]
  socialVideoUrls String[]
}

model Place {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?
  image       String?
  location    String?
  author      String?
  status      String   @default("draft")
}

model Category {
  id          String   @id
  name        String
  slug        String
  parent      String   @default("None")
  description String   @default("")
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model Media {
  id           String   @id @default(cuid())
  url          String
  publicId     String?
  createdAt    DateTime @default(now())
  category     String?
  isFeatured   Boolean  @default(false)
  name         String?
  type         String?
  altText      String?
  articleId    String?
  articleTitle String?
  caption      String?
  fileSize     Int?
}

model Pincode {
  id          String   @id @default(cuid())
  areaName    String
  pincode     String   @unique
  city        String
  description String   @db.Text
  image       String?
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id          String   @id
  name        String   @unique
  slug        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model User {
  id        String    @id
  name      String
  email     String    @unique
  phone     String?
  password  String
  role      String
  category  String?
  status    String    @default("Active")
  createdAt DateTime  @default(now())
  updatedAt DateTime
  lastLogin DateTime?
}

model Campaign {
  id            String   @id @default(uuid())
  name          String
  topics        String[]
  categories    String[]
  intervalHours Int      @default(24)
  lastRunAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  durationValue Int      @default(24)
  durationUnit  String   @default("hour")
}

model CoveredTopic {
  id          String   @id @default(cuid())
  campaignId  String
  topic       String
  sourceHash  String   // unique fingerprint of the source content
  publishedAt DateTime @default(now())

  @@index([campaignId, topic])
}

model TopicRun {
  id          String   @id @default(uuid())
  campaignId  String
  topic       String
  lastRunAt   DateTime @default(now())

  @@unique([campaignId, topic])
}

model Advertisement {
  id          String   @id @default(cuid())
  slotType    String   // e.g., "header", "sidebar", "infeed", "footer"
  imageUrl    String   // The URL of the banner image
  targetUrl   String   // Where the ad clicks to
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}